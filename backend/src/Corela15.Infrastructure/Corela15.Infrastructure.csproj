<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Corela15.Application\Corela15.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Persistence\Seeds\CatalogoCucCompleto.sql" />
    <EmbeddedResource Include="Persistence\Seeds\TipoActividad.sql" />
    <EmbeddedResource Include="Persistence\Seeds\ActividadEconomica.sql" />
    <EmbeddedResource Include="Persistence\Seeds\Profesion.sql" />
    <!-- Modelo semántico de Reportería Gerencial (portado de SIGA),
         embebido para no depender del directorio de trabajo real al
         arrancar (ver SemanticModelStore.cs). -->
    <EmbeddedResource Include="Reporteria\Semantic\models\*.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="EFCore.NamingConventions" Version="8.0.3" />
    <!-- IConfiguration.GetValue<T>(), usado por el motor de Reportería Gerencial (Query/QueryCompiler.cs, QueryExecutor.cs). -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <!-- Usado por ObligacionSyncService (Estructuras Financieras/OF01) y por
         el motor de Reportería Gerencial (Reporteria/Query/QueryExecutor.cs,
         portado de SIGA): las dos únicas excepciones reales y acotadas a la
         regla de oro del proyecto, ambas de solo lectura (db_datareader). El
         resto del backend nunca se conecta a Softbank, solo Postgres. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
